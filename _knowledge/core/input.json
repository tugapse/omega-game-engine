  "vector_memory": {
    "semantic_summary": "This component provides a centralized, static interface for tracking and querying user input from mouse, keyboard, and gamepad devices. It abstracts raw input events into frame-independent state variables, allowing game logic to poll for current states like button presses and cursor positions. It manages transient states using functions like cleanLastFrame() to ensure state integrity across the game loop frames."
  },
