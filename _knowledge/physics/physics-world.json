  "vector_memory": {
    "semantic_summary": "PhysicsWorld is the core simulation manager responsible for advancing the state of physical entities using a PhysicsBackend. It manages time integration via an accumulator pattern to ensure fixed-step updates, handling body and collider registration through flush(). It exposes comprehensive hooks (onContact, onBeforeStep) for external systems to observe simulation events and interact with the physics state.",
    "architecture_role": "Core Simulation Service"
  },
