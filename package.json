{
  "name": "omega-game-engine",
  "version": "5.0.0",
  "description": "Omega game engine library.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "embed-shaders": "node scripts/embed-shaders.mjs",
    "prebuild": "npm run embed-shaders",
    "build": "tsc && npm run build:types",
    "build-js": "npm run build-js:dev && npm run build-js:prod",
    "build-js:dev": "rollup -c && api-extractor run --local --verbose",
    "build-js:prod": "cross-env NODE_ENV=production rollup -c && api-extractor run --local --verbose",
    "build-docs": "npx typedoc --entryPointStrategy Expand src --cleanOutputDir false",
    "serve-docs": "npx serve docs",
    "build-all": "npm run build && npm run build-js && npm run build-docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "dts-bundle-generator -o dist/omega-game-engine.d.ts src/index.ts --no-check --export-referenced-types false",
    "build:games": "node scripts/build-games.mjs",
    "check:games": "tsc -p games/bowling --noEmit && tsc -p games/golf --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@microsoft/api-extractor": "^7.52.11",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "cross-env": "^10.0.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.25.10",
    "rollup": "^2.79.2",
    "rollup-plugin-terser": "^7.0.2",
    "typedoc": "^0.28.10",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  }
}
